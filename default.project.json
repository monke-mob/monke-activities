{
    "name": "monke activities",
    "tree": {
        "$className": "DataModel",

        "ReplicatedStorage": {
            "$className": "ReplicatedStorage",
            "$path": "src/Shared",
            "$ignoreUnknownInstances": true,

            "Packages": {
                "$path": "Packages"
            }
        },

        "ServerScriptService": {
            "$className": "ServerScriptService",
            "$ignoreUnknownInstances": false,
            "$path": "src/Server"
        },

        "ReplicatedFirst": {
            "$className": "ReplicatedFirst",
            "$ignoreUnknownInstances": true,

            "Services": {
                "$ignoreUnknownInstances": false,
                "$path": "src/Client/Services"
            },

            "Components": {
                "$ignoreUnknownInstances": false,
                "$path": "src/Client/Components"
            },

            "UserInterface": {
                "$ignoreUnknownInstances": false,
                "$path": "src/Client/UserInterface"
            }
        },

        "StarterPlayer": {
            "$className": "StarterPlayer",
            "$ignoreUnknownInstances": true,

            "StarterPlayerScripts": {
                "$className": "StarterPlayerScripts",
                "$ignoreUnknownInstances": true,

                "Runtime": {
                    "$ignoreUnknownInstances": false,
                    "$path": "src/Client/Runtime"
                }
            }
        }
    }
}
